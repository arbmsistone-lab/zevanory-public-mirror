{
  "policy_id": "ZEVANORY-10P-APPROVAL",
  "version": "1.0.0",
  "mode": "fail_closed",
  "scope": {
    "artifact_types": [
      "creative",
      "audio",
      "image",
      "product",
      "system"
    ],
    "decision": "approval_or_promotion"
  },
  "approval_rule": {
    "strategy": "all_pillars_required",
    "partial_approval_forbidden": true,
    "score_compensation_forbidden": true,
    "minimum_confidence": 0.99,
    "required_excellence": 100,
    "required_pillar_status": "PROVEN",
    "no_manifest_means": "NOT_APPROVED"
  },
  "evidence_contract": {
    "minimum_items_per_pillar": 1,
    "reproducible_required": true,
    "pass_result_required": true,
    "artifact_revision_binding_required": true,
    "source_required": true,
    "locator_required": true,
    "sha256_required": true,
    "verified_at_required": true,
    "expired_evidence_forbidden_when_valid_until_present": true
  },

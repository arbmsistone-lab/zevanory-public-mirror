{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zevanory",
  "main": "src/cloudflare-worker.mjs",
  "compatibility_date": "2026-09-04",
  "secrets": {
    "required": ["DATABASE_URL", "PUBLIC_BASE_URL"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}

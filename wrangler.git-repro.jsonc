{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zevanory-git-repro",
  "main": "worker/git-repro.mjs",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "VENDA_GLOBALMENTE_HABILITADA": "false",
    "PRE_VENDA_PORTOES_APROVADOS": "false",
    "VENDAS_PELO_WHATSAPP_HABILITADAS": "false",
    "CHECKOUT_ATIVADO": "false",
    "EVENTOS_FINANCEIROS_ATIVADOS": "false",
    "LIBERACAO_ABSOLUTA_APROVADA": "false",
    "ZEVANORY_DEPLOYMENT_ENV": "staging-reconciliation",
    "ZEVANORY_RELEASE_REF": "git-repro"
  },
  "triggers": { "crons": ["17 * * * *"] }
}

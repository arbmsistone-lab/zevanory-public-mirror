{
  "schema": "zevanory.test-vectors.mercadopago-signature.v1",
  "title": "Vetores de teste reproduzíveis pelo auditor: x-signature Mercado Pago (Roteiro v4.4, seção 7)",
  "secret": "FICTITIOUS-TEST-SECRET-do-not-use",
  "secret_label": "FICTITIOUS secret for test vectors only. Not a Mercado Pago credential, never used in any environment. Do not use.",
  "secret_is_fictitious": true,
  "now_iso": "2026-10-24T12:00:00.000Z",
  "now_ms": 1792843200000,
  "window_ms": 600000,
  "production_function": "verifyMercadoPagoSignature in worker/cloudflare-worker.recovered.mjs (extracted from the source text by tests/mercadopago-signature-vectors.test.mjs; no copy)",
  "spec": {
    "consulted": "2026-10-24",
    "sources": [
      "https://www.mercadopago.com.uy/developers/en/docs/checkout-pro/payment-notifications.md",
      "https://www.mercadopago.com.br/developers/en/docs/qr-code/notifications",
      "https://www.mercadopago.com/developers/en/docs/your-integrations/notifications/webhooks"
    ],
    "header": "x-signature: ts=<ts>,v1=<hex>; extract ts and v1 by splitting on ','",
    "manifest_template": "id:<data.id>;request-id:<x-request-id>;ts:<ts>;",
    "absent_values": "a pair whose value is absent from the request is removed from the manifest",
    "data_id_case": "alphanumeric data.id is lowercased (official samples); payment ids here are numeric",
    "hmac": "HMAC-SHA256(secret, manifest) in lowercase hex, compared with v1 in constant time",
    "timestamp_tolerance": "not specified by the documentation; the Worker uses |now - ts| <= 10 min (symmetric)",
    "replay": "not specified by the documentation"
  },
  "fields": {
    "manifest": "canonical manifest per the official template built from the RECEIVED request (query data.id, x-request-id, ts parsed per spec), absent pairs removed",
    "expected_v1": "printf '%s' \"$manifest\" | openssl dgst -sha256 -hmac \"$secret\"",
    "sha256_manifest": "printf '%s' \"$manifest\" | openssl dgst -sha256",
    "sha256_expected_v1": "printf '%s' \"$expected_v1\" | openssl dgst -sha256",
    "signed_manifest": "manifest the presented v1 was computed over (null when v1 was not produced by HMAC)",
    "presented_v1": "v1 carried in x-signature",
    "hmac_matches": "presented_v1 (lowercased) == expected_v1",
    "expected": "result of verifyMercadoPagoSignature: accept | refuse"
  },

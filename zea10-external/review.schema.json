{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zevanory.api.br/zea10-external/review.schema.json",
  "title": "ZEA-10 Independent External Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pillar_ids",
    "reviewer_org",
    "reviewer_name_or_id",
    "independence_statement",
    "scope",
    "evaluated_sha",
    "date",
    "method",
    "evidence_checked",
    "findings",
    "result",
    "report_id_or_hash",
    "signature_or_verification_url"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pillar_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "pattern": "^ZEA10-(0[1-9]|10)$"
      }
    },
    "reviewer_org": {
      "type": "string",
      "minLength": 2
    },
    "reviewer_name_or_id": {
      "type": "string",
      "minLength": 2
    },
    "independence_statement": {
      "type": "string",
      "minLength": 20
    },
    "scope": {
      "type": "string",
      "minLength": 20
    },
    "evaluated_sha": {
      "pattern": "^[0-9a-f]{40}$"
    },
    "evaluated_production_release_sha": {
      "pattern": "^[0-9a-f]{40}$"
    },
    "date": {
      "format": "date"
    },
    "method": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence_checked": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "title",
          "detail"
        ],
        "properties": {
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "detail": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "result": {
      "enum": [
        "pass",
        "pass_with_findings",
        "fail"
      ]
    },
    "report_id_or_hash": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "signature_or_verification_url": {
      "type": "string",
      "minLength": 8
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/live",
      "destination": "/api/status?probe=live"
    },
    {
      "source": "/api/health",
      "destination": "/api/status?probe=health"
    },
    {
      "source": "/api/checkout/asaas",
      "destination": "/api/checkout?provider=asaas"
    },
    {
      "source": "/api/checkout/mercadopago",
      "destination": "/api/checkout?provider=mercadopago"
    },
    {
      "source": "/api/webhooks/asaas",
      "destination": "/api/webhooks?provider=asaas"
    },
    {
      "source": "/api/webhooks/mercadopago",
      "destination": "/api/webhooks?provider=mercadopago"
    },
    {
      "source": "/api/webhooks/resend",
      "destination": "/api/webhooks?provider=resend"
    },
    {
      "source": "/api/webhooks/meta",
      "destination": "/api/webhooks?provider=meta"
    },
    {
      "source": "/arbm-sist",
      "destination": "/public/arbm-sist.html"
    },
    {
      "source": "/api/events/public",
      "destination": "/api/events-public"
    },
    {
      "source": "/api/events/operator",
      "destination": "/api/events-operator"
    },
    {
      "source": "/api/agent/run",
      "destination": "/api/agent-run"
    },
    {
      "source": "/api/agent/status",
      "destination": "/api/agent-status"
    },
    {
      "source": "/api/activation/readiness",
      "destination": "/api/config?view=activation"
    },
    {
      "source": "/piloto",
      "destination": "/public/piloto.html"
    },
    {
      "source": "/termos",
      "destination": "/public/termos.html"
    },
    {
      "source": "/privacidade",
      "destination": "/public/privacidade.html"
    },
    {
      "source": "/arbm-sist/privacidade",
      "destination": "/public/arbm-sist-privacidade.html"
    },
    {
      "source": "/reembolso",
      "destination": "/public/reembolso.html"
    },
    {
      "source": "/afiliados",
      "destination": "/public/afiliados.html"
    },
    {
      "source": "/legal.css",
      "destination": "/public/legal.css"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    }
  ]
}

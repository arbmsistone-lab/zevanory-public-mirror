# Contestação Codex 010: no Windows, checkout com CRLF quebra os scripts bash (set: pipefail\r).
scripts/ops/*.sh text eol=lf
sandbox/rollback-secret-probe/*.sh text eol=lf
# E2: content-hashed assets: the hash covers the exact served bytes, so no EOL conversion on checkout.
sales-public/assets/** -text
# GitHub Pages redirect layer (scripts/build_pages_mirror.py): generated, LF on every platform.
pages-mirror/** text eol=lf
_config.yml text eol=lf
